generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String             @id @default(cuid())
  platform          Platform
  pageId            String
  pageName          String
  accessToken       String
  tokenExpiresAt    DateTime?
  instagramId       String?
  createdAt         DateTime           @default(now())
  monthlyPostTarget Int                @default(20)
  lastSyncAt        DateTime?
  cachedMonthTotal  Int                @default(0)
  cachedMissedDays  Int                @default(0)
  cachedTodayPosted Int                @default(0)
  cachedScheduled   Int                @default(0)
  cachedSyncMonth   Int?
  cachedSyncYear    Int?
  cachedStoriesCount Int               @default(0)
  username          String?
  followers         Int                @default(0)
  syncLogs          AccountSyncLog[]
  posts             Post[]
  followerSnapshots FollowerSnapshot[]

  @@unique([platform, pageId])
}

model FollowerSnapshot {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  followers Int
  date      DateTime @default(now())

  @@index([accountId, date])
}

model AccountSyncLog {
  id        String   @id @default(cuid())
  accountId String
  syncedAt  DateTime @default(now())
  success   Boolean
  error     String?
  account   Account  @relation(fields: [accountId], references: [id])
}

model Post {
  id          String     @id @default(cuid())
  accountId   String
  platform    Platform
  status      PostStatus @default(DRAFT)
  caption     String
  mediaUrls   String[]
  thumbnailUrl String?
  mediaType   MediaType  @default(IMAGE)
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String?
  errorMsg    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  analytics   Analytics?
  account     Account    @relation(fields: [accountId], references: [id])
}

model Analytics {
  id          String   @id @default(cuid())
  postId      String   @unique
  impressions Int      @default(0)
  reach       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  saves       Int      @default(0)
  clicks      Int      @default(0)
  fetchedAt   DateTime @default(now())
  post        Post     @relation(fields: [postId], references: [id])
}

model User {
  Id           Int       @id @default(autoincrement())
  UserName     String    @unique
  Email        String?
  PasswordHash String
  FullName     String?
  Role         String    @default("USER")
  IsActive     Boolean   @default(true)
  LastLogin    DateTime?
  CreatedOn    DateTime  @default(now())
}

enum Platform {
  FACEBOOK
  INSTAGRAM
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
}
